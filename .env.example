# === 로그인 계정 (선택) ===
# 계정이 없어도 됩니다. 비워 두면 비로그인(익명)으로 동작합니다.
DC_ID=your_dcinside_id
DC_PW=your_dcinside_password

# === 비로그인(익명)용 닉네임/비밀번호 ===
# 비로그인으로 댓글/글을 쓸 때 사용합니다.
# DC_NICKNAME을 비우면 config.json의 bot_nickname을 사용합니다.
# DC_COMMENT_PW는 댓글/글 작성용 비밀번호이며, 나중에 본인이 쓴 글을 지울 때 필요합니다.
DC_NICKNAME=ㅇㅇ봇
DC_COMMENT_PW=some_password_for_comment

# === Gemini (RAG + LLM) ===
GEMINI_API_KEY=your_gemini_api_key

# === LLM (폴백용) ===
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# === 멀티키 로테이션 (선택) ===
# 콤마로 구분해 여러 키를 넣으면 요청마다 번갈아가며 사용하고,
# 한 키가 429/403으로 실패하면 다음 키로 자동 폴오버됩니다. (쿼터 N배)
# 설정하지 않으면 위 단일 키(GEMINI_API_KEY / LLM_API_KEY)를 사용합니다.
# GEMINI_API_KEYS=key1,key2,key3
# LLM_API_KEYS=key1,key2,key3

# OpenAI 호환 서버를 쓸 때 (예: 로컬, vLLM, 타사)
# LLM_BASE_URL=https://api.openai.com/v1

# 쿠키/메모리 파일 위치를 바꾸고 싶을 때 (기본: 프로젝트 폴더)
# COOKIE_FILE=./cookies.json
# MEMORY_FILE=./memory.json

# 성공한 글/댓글 기록 파일 (내용+링크 포함, 기본: ./activity.jsonl)
# ACTIVITY_FILE=./activity.jsonl